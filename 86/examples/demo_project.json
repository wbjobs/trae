  "scripts": {
    "temp_control": "# 温度PID控制脚本\n# 简单的温度闭环控制逻辑\n\nsetpoint = 80.0  # 设定温度\ncurrent_temp = tags['AI_TEMP_01']\n\n# 简单的比例控制\nerror = setpoint - current_temp\nkp = 0.5\n\nif error > 5:\n    tags['AO_FLOW_01'] = min(100, tags['AO_FLOW_01'] + kp * error)\nelif error < -5:\n    tags['AO_FLOW_01'] = max(0, tags['AO_FLOW_01'] + kp * error)\n\nprint(f'温度: {current_temp:.1f}℃, 控制输出: {tags[\"AO_FLOW_01\"]:.1f}')\n"
  },
