# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anomaly_detection

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-token
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=your-bucket

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Alert Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-password
DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key
