    function generateDemoData(accountId, folderId, totalCount, options, onProgress, onComplete) {
        if (!options) options = {};
        var batchSize = options.batchSize || 500;
        var startIndex = options.startIndex || 0;
        var useThreading = options.useThreading !== false;

        DB.dropFTSTriggers();
        DB.prepareBatchInsert();
        DB.beginTransaction();

        var now = Math.floor(Date.now() / 1000);
        var count = 0;
        var processed = startIndex;
        var batchStart = 0;
        var batchEnd = Math.min(batchSize, totalCount);
        var msgIdMap = {};
        var idMap = {};
        var THREAD_INTERVAL = 10;
        var REPLY_DEPTH = 4;

        function processBatch() {
            if (DB.isCancelled()) {
                DB.rollback();
                DB.finalizeBatchInsert();
                DB.createFTSTriggers();
                if (onComplete) onComplete({ cancelled: true, count: count });
                return;
            }

            for (var i = batchStart; i < batchEnd && i < totalCount; i++) {
                var subjectIdx = i % demoSubjects.length;
                var senderIdx = i % demoSenders.length;
                var bodyIdx = i % demoBodies.length;
                var hasAttachment = (i % 7 == 0);
                var isUnread = (i % 3 == 0);
                var isFlagged = (i % 13 == 0);

                var subject = demoSubjects[subjectIdx]
                    .replace("{week}", Math.floor(i / 20) + 1)
                    .replace("{topic}", demoTopics[i % demoTopics.length])
                    .replace("{order}", 10000 + i)
                    .replace("{date}", (i % 28 + 1) + "日")
                    .replace("{month}", (i % 12 + 1))
                    .replace("{pr}", 1000 + i);

                var msgId = "<demo-" + i + "-" + now + "@example.com>";
                var inReplyTo = "";
                var threadId = 0;

                if (useThreading) {
                    var positionInThread = i % THREAD_INTERVAL;
                    if (positionInThread > 0 && positionInThread <= REPLY_DEPTH && msgIdMap[i - positionInThread]) {
                        inReplyTo = msgIdMap[i - positionInThread];
                        var rootIdx = i - positionInThread;
                        while (rootIdx > 0 && idMap[rootIdx - (rootIdx % THREAD_INTERVAL)]) {
                            rootIdx = rootIdx - (rootIdx % THREAD_INTERVAL);
                        }
                        threadId = idMap[rootIdx] || 0;
                        subject = "Re: " + subject;
                    }
                }

                var emailData = {
                    account_id: accountId,
                    folder_id: folderId,
                    uid: i + 1,
                    msg_id: msgId,
                    in_reply_to: inReplyTo,
                    thread_id: threadId,
                    subject: subject,
                    sender_name: demoSenders[senderIdx].name,
                    sender_email: demoSenders[senderIdx].email,
                    recipients: "user@example.com",
                    date_received: now - (i * 3600),
                    date_sent: now - (i * 3600) - 300,
                    is_read: isUnread ? 0 : 1,
                    is_flagged: isFlagged ? 1 : 0,
                    has_attachments: hasAttachment ? 1 : 0,
                    body_text: demoBodies[bodyIdx],
                    body_html: "<html><body style='font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6;'>" +
                        demoBodies[bodyIdx].replace(/\n/g, "<br>") + "</body></html>",
                    size: demoBodies[bodyIdx].length
                };

                var emailId = DB.saveEmailBatch(emailData);
                msgIdMap[i] = msgId;
                idMap[i] = emailId;

                if (hasAttachment) {
                    var filenames = [
                        "项目报告_" + i + ".pdf",
                        "数据分析_" + i + ".xlsx",
                        "设计方案_" + i + ".docx",
                        "产品截图_" + i + ".png",
                        "会议纪要_" + i + ".pdf"
                    ];
                    var types = [
                        "application/pdf",
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                        "image/png",
                        "application/pdf"
                    ];
                    var attIdx = i % filenames.length;
                    DB.saveAttachment(emailId, filenames[attIdx], types[attIdx], 10240 + i * 37, "");
                }

                count++;
                processed++;
            }

            DB.commit();
            DB.beginTransaction();

            var progress = Math.floor((processed / totalCount) * 100);
            if (onProgress) {
                onProgress(processed, totalCount, progress);
            }

            batchStart = batchEnd;
            batchEnd = Math.min(batchStart + batchSize, totalCount);

            if (processed < totalCount) {
                setTimeout(processBatch, 0);
            } else {
                DB.commit();
                DB.finalizeBatchInsert();

                if (useThreading) {
                    DB.rebuildThreadIds();
                }

                DB.createFTSTriggers();

                if (onComplete) {
                    onComplete({ cancelled: false, count: count });
                }
            }
        }

        processBatch();
    }

    function generateDemoTags(accountId) {
        var tagNames = ["重要", "工作", "个人", "待办", "紧急", "已归档", "待回复", "参考"];
        var tagColors = ["#e74c3c", "#3498db", "#2ecc71", "#9b59b6", "#f39c12", "#1abc9c", "#e67e22", "#34495e"];
        var tagIds = [];

        for (var t = 0; t < tagNames.length; t++) {
            var tid = DB.saveTag(tagNames[t], tagColors[t]);
            tagIds.push(tid);
        }

        return tagIds;
    }

    function generateDemoEmailTags(emailIds, tagIds) {
        for (var i = 0; i < emailIds.length; i++) {
            var numTags = (i % 3) + 1;
            for (var t = 0; t < numTags; t++) {
                var tagIdx = (i + t) % tagIds.length;
                DB.addTagToEmail(emailIds[i], tagIds[tagIdx]);
            }
        }
    }

}
