namespace IMAP {

    var isConnected = false;
    var connection = null;
    var currentTag = 0;
    var responseBuffer = "";

    function getNextTag() {
        currentTag++;
        return "A" + currentTag;
    }

    function connect(account) {
        return new Promise(function(resolve, reject) {
            try {
                var socket = new Net.Socket();
                
                socket.on("connect", function() {
                    isConnected = true;
                    responseBuffer = "";
                });

                socket.on("data", function(data) {
                    responseBuffer += data.toString();
                    processResponse();
                });

                socket.on("error", function(err) {
                    isConnected = false;
                    reject(err);
                });

                socket.on("close", function() {
                    isConnected = false;
                });

                socket.connect(account.imap_port, account.imap_server, function() {
                    if (account.use_ssl) {
                        socket.startTLS();
                    }
                    connection = socket;
                    waitForGreeting().then(function() {
                        login(account.email, account.password).then(function() {
                            resolve(true);
                        }, function(err) {
                            reject(err);
                        });
                    }, function(err) {
                        reject(err);
                    });
                });
            } catch (e) {
                reject(e);
            }
        });
    }

    function waitForGreeting() {
        return new Promise(function(resolve, reject) {
            var checkGreeting = function() {
                if (responseBuffer.indexOf("* OK") != -1) {
                    responseBuffer = "";
                    resolve(true);
                } else if (responseBuffer.indexOf("* NO") != -1 || responseBuffer.indexOf("* BAD") != -1) {
                    reject("Server greeting error");
                } else {
                    setTimeout(checkGreeting, 100);
                }
            };
            setTimeout(checkGreeting, 100);
        });
    }

    function sendCommand(tag, command) {
        if (!isConnected || !connection) {
            return Promise.reject("Not connected");
        }
        return new Promise(function(resolve, reject) {
            var fullCommand = tag + " " + command + "\r\n";
            connection.send(fullCommand);
            
            var checkResponse = function() {
                var lines = responseBuffer.split("\r\n");
                for (var i = 0; i < lines.length; i++) {
                    if (lines[i].indexOf(tag + " OK") == 0) {
                        var response = responseBuffer;
                        responseBuffer = "";
                        resolve(response);
                        return;
                    } else if (lines[i].indexOf(tag + " NO") == 0 || lines[i].indexOf(tag + " BAD") == 0) {
                        responseBuffer = "";
                        reject(lines[i]);
                        return;
                    }
                }
                setTimeout(checkResponse, 100);
            };
            setTimeout(checkResponse, 100);
        });
    }

    function login(username, password) {
        var tag = getNextTag();
        return sendCommand(tag, 'LOGIN "' + username + '" "' + password + '"');
    }

    function selectFolder(folderName) {
        var tag = getNextTag();
        return sendCommand(tag, 'SELECT "' + folderName + '"');
    }

    function fetchEmailHeaders(startUid, endUid) {
        var tag = getNextTag();
        var sequence = startUid + ":" + (endUid || "*");
        return sendCommand(tag, 'UID FETCH ' + sequence + ' (UID FLAGS INTERNALDATE BODY.PEEK[HEADER.FIELDS (FROM TO SUBJECT DATE MESSAGE-ID)])');
    }

    function fetchEmailBody(uid) {
        var tag = getNextTag();
        return sendCommand(tag, 'UID FETCH ' + uid + ' (BODY.PEEK[])');
    }

    function parseHeaders(headerText) {
        var headers = {
            from: "",
            to: "",
            subject: "",
            date: "",
            "message-id": ""
        };
        
        var lines = headerText.split("\n");
        var currentKey = null;
        
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line.length == 0) continue;
            
            var colonIndex = line.indexOf(":");
            if (colonIndex > 0) {
                var key = line.substring(0, colonIndex).toLowerCase();
                var value = line.substring(colonIndex + 1).trim();
                if (headers.hasOwnProperty(key)) {
                    headers[key] = value;
                    currentKey = key;
                } else {
                    currentKey = null;
                }
            } else if (currentKey && (line.indexOf(" ") == 0 || line.indexOf("\t") == 0)) {
                headers[currentKey] += " " + line.trim();
            }
        }
        
        return headers;
    }

    function parseEmailAddress(addressStr) {
        var result = { name: "", email: "" };
        var angleIndex = addressStr.indexOf("<");
        if (angleIndex >= 0) {
            result.name = addressStr.substring(0, angleIndex).trim().replace(/"/g, "");
            var closeIndex = addressStr.indexOf(">", angleIndex);
            if (closeIndex >= 0) {
                result.email = addressStr.substring(angleIndex + 1, closeIndex).trim();
            }
        } else {
            result.email = addressStr.trim();
        }
        return result;
    }

    function parseDate(dateStr) {
        try {
            return new Date(dateStr).getTime() / 1000;
        } catch (e) {
            return Date.now() / 1000;
        }
    }

    function syncFolder(accountId, folderName, onProgress) {
        return new Promise(function(resolve, reject) {
            var folder = DB.getFolder(accountId, folderName);
            var highestUid = folder ? folder.highest_uid : 0;
            
            selectFolder(folderName).then(function(response) {
                var match = response.match(/UIDVALIDITY (\d+)/);
                var uidValidity = match ? parseInt(match[1]) : 0;
                
                match = response.match(/HIGHESTMODSEQ (\d+)/);
                var newHighestUid = match ? parseInt(match[1]) : highestUid + 100;
                
                var folderId = DB.saveFolder(accountId, folderName, uidValidity, newHighestUid);
                
                if (onProgress) onProgress("Fetching email list...");
                
                var startUid = highestUid > 0 ? highestUid + 1 : 1;
                fetchEmailHeaders(startUid, "*").then(function(response) {
                    var emails = parseFetchResponse(response);
                    var count = 0;
                    var total = emails.length;
                    
                    function processNextEmail() {
                        if (count >= total) {
                            DB.updateAccountLastSync(accountId, Date.now() / 1000);
                            resolve({ folderId: folderId, count: total });
                            return;
                        }
                        
                        var email = emails[count];
                        if (onProgress) onProgress("Processing email " + (count + 1) + "/" + total);
                        
                        fetchEmailBody(email.uid).then(function(bodyResponse) {
                            var body = parseBodyResponse(bodyResponse);
                            
                            var emailData = {
                                account_id: accountId,
                                folder_id: folderId,
                                uid: email.uid,
                                msg_id: email.messageId,
                                subject: email.subject,
                                sender_name: email.from.name,
                                sender_email: email.from.email,
                                recipients: email.to,
                                date_received: email.date,
                                date_sent: email.date,
                                is_read: email.isRead ? 1 : 0,
                                is_flagged: email.isFlagged ? 1 : 0,
                                has_attachments: body.hasAttachments ? 1 : 0,
                                body_text: body.text,
                                body_html: body.html,
                                size: body.size
                            };
                            
                            var emailId = DB.saveEmail(emailData);
                            
                            for (var i = 0; i < body.attachments.length; i++) {
                                var att = body.attachments[i];
                                DB.saveAttachment(emailId, att.filename, att.contentType, att.size, "");
                            }
                            
                            count++;
                            setTimeout(processNextEmail, 10);
                        }, function(err) {
                            count++;
                            setTimeout(processNextEmail, 10);
                        });
                    }
                    
                    if (total > 0) {
                        processNextEmail();
                    } else {
                        resolve({ folderId: folderId, count: 0 });
                    }
                }, reject);
            }, reject);
        });
    }

    function parseFetchResponse(response) {
        var emails = [];
        var sections = response.split(/^\* \d+ FETCH /m);
        
        for (var i = 1; i < sections.length; i++) {
            var section = sections[i];
            var email = {
                uid: 0,
                isRead: false,
                isFlagged: false,
                from: { name: "", email: "" },
                to: "",
                subject: "",
                date: 0,
                messageId: ""
            };
            
            var uidMatch = section.match(/UID (\d+)/);
            if (uidMatch) email.uid = parseInt(uidMatch[1]);
            
            var flagsMatch = section.match(/FLAGS \(([^)]*)\)/);
            if (flagsMatch) {
                var flags = flagsMatch[1];
                email.isRead = flags.indexOf("\\Seen") != -1;
                email.isFlagged = flags.indexOf("\\Flagged") != -1;
            }
            
            var dateMatch = section.match(/INTERNALDATE "([^"]*)"/);
            if (dateMatch) email.date = parseDate(dateMatch[1]);
            
            var headerMatch = section.match(/BODY\[HEADER\.FIELDS.*?\]\s*\{(\d+)\}\s*([\s\S]*?)\)/);
            if (headerMatch) {
                var headers = parseHeaders(headerMatch[2]);
                email.from = parseEmailAddress(headers.from);
                email.to = headers.to;
                email.subject = headers.subject;
                email.messageId = headers["message-id"];
                if (headers.date) email.date = parseDate(headers.date);
            }
            
            if (email.uid > 0) {
                emails.push(email);
            }
        }
        
        return emails;
    }

    function parseBodyResponse(response) {
        var result = {
            text: "",
            html: "",
            size: 0,
            hasAttachments: false,
            attachments: []
        };
        
        var bodyMatch = response.match(/BODY\[\]\s*\{(\d+)\}\s*([\s\S]*?)\)A\d+ OK/);
        if (bodyMatch) {
            result.size = parseInt(bodyMatch[1]);
            var content = bodyMatch[2];
            
            if (content.indexOf("Content-Type: multipart/") != -1) {
                var boundaryMatch = content.match(/boundary="?([^";\n]+)"?/i);
                if (boundaryMatch) {
                    var boundary = boundaryMatch[1];
                    var parts = content.split("--" + boundary);
                    
                    for (var i = 1; i < parts.length; i++) {
                        var part = parts[i];
                        if (part.indexOf("--") == 0) continue;
                        
                        var contentTypeMatch = part.match(/Content-Type: ([^;\n]+)/i);
                        var contentType = contentTypeMatch ? contentTypeMatch[1].trim().toLowerCase() : "";
                        
                        var filenameMatch = part.match(/filename="?([^";\n]+)"?/i);
                        var isAttachment = part.indexOf("Content-Disposition: attachment") != -1 || !!filenameMatch;
                        
                        if (isAttachment && filenameMatch) {
                            result.hasAttachments = true;
                            result.attachments.push({
                                filename: filenameMatch[1],
                                contentType: contentType,
                                size: part.length
                            });
                        } else if (contentType == "text/plain") {
                            var textStart = part.indexOf("\n\n");
                            if (textStart != -1) {
                                result.text = decodeQuotedPrintable(part.substring(textStart + 2));
                            }
                        } else if (contentType == "text/html") {
                            var htmlStart = part.indexOf("\n\n");
                            if (htmlStart != -1) {
                                result.html = decodeQuotedPrintable(part.substring(htmlStart + 2));
                            }
                        }
                    }
                }
            } else {
                var textStart = content.indexOf("\n\n");
                if (textStart != -1) {
                    result.text = decodeQuotedPrintable(content.substring(textStart + 2));
                }
            }
        }
        
        return result;
    }

    function decodeQuotedPrintable(str) {
        return str.replace(/=([0-9A-F]{2})/g, function(match, hex) {
            return String.fromCharCode(parseInt(hex, 16));
        }).replace(/=\n/g, "");
    }

    function disconnect() {
        if (connection) {
            var tag = getNextTag();
            sendCommand(tag, "LOGOUT").then(function() {
                connection.close();
                connection = null;
                isConnected = false;
            });
        }
    }

    function syncAll(account, onProgress, onComplete, onError) {
        var folders = ["INBOX", "Sent", "Drafts", "Trash"];
        var currentFolder = 0;
        var totalEmails = 0;
        
        connect(account).then(function() {
            function syncNext() {
                if (currentFolder >= folders.length) {
                    disconnect();
                    if (onComplete) onComplete(totalEmails);
                    return;
                }
                
                var folder = folders[currentFolder];
                if (onProgress) onProgress("Syncing " + folder + "...");
                
                syncFolder(account.id, folder, onProgress).then(function(result) {
                    totalEmails += result.count;
                    currentFolder++;
                    setTimeout(syncNext, 500);
                }, function(err) {
                    currentFolder++;
                    setTimeout(syncNext, 500);
                });
            }
            syncNext();
        }, function(err) {
            if (onError) onError(err);
        });
    }

