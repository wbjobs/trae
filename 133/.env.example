# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_SUBJECT=function.invoke

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=functions
MINIO_SSL=false

# HTTP Server Configuration
HTTP_PORT=8080

# Wasm Cache Directory
WASM_CACHE_DIR=./.cache/wasm

# Function Execution Configuration
FUNCTION_TIMEOUT=3s
FUNCTION_MAX_TIMEOUT=10s
WORKER_POOL_SIZE=10
MAX_CONCURRENCY=50
