        "target_width": 2048,
        "target_height": 2732,
        "aspect_ratio": "4:3",
        "scale_mode": "contain"
      },
      "rendering": {
        "tile_size": 36,
        "anti_aliasing": true,
        "shadows": true,
        "shadow_quality": "low",
        "particles": true,
        "particle_limit": 100,
        "post_processing": false,
        "fog_quality": "medium",
        "max_fps": 60
