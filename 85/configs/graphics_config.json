      }
    },
    "ultrawide": {
      "name": "超宽屏显示器",
      "description": "适用于21:9超宽屏显示器",
      "resolution": {
        "target_width": 3440,
        "target_height": 1440,
        "aspect_ratio": "21:9",
        "scale_mode": "contain",
        "extra_wide_support": true
