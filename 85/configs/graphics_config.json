{
  "default_profile": "auto",
  "profiles": {
    "auto": {
      "name": "自动检测",
      "description": "根据设备性能自动选择最佳配置"
    },
    "low_end_mobile": {
      "name": "低端移动设备",
      "description": "适用于旧款智能手机和平板",
      "resolution": {
        "target_width": 720,
        "target_height": 1280,
        "aspect_ratio": "16:9",
        "scale_mode": "contain"
      },
      "rendering": {
        "tile_size": 24,
        "anti_aliasing": false,
        "shadows": false,
        "particles": false,
        "post_processing": false,
        "fog_quality": "low",
        "max_fps": 30
      },
      "ui": {
        "scale": 0.8,
        "font_size": "small",
        "simplified_ui": true,
        "hide_effects": true,
        "touch_target_size": 48
      },
      "performance": {
        "reduce_draw_calls": true,
        "texture_compression": true,
        "limit_animations": true,
        "disable_background_effects": true
      }
    },
    "mid_range_mobile": {
      "name": "中端移动设备",
      "description": "适用于主流智能手机和平板",
      "resolution": {
        "target_width": 1080,
        "target_height": 1920,
        "aspect_ratio": "16:9",
        "scale_mode": "contain"
      },
      "rendering": {
        "tile_size": 32,
        "anti_aliasing": true,
        "shadows": true,
        "shadow_quality": "low",
        "particles": true,
        "particle_limit": 50,
        "post_processing": false,
        "fog_quality": "medium",
        "max_fps": 60
      },
      "ui": {
        "scale": 1.0,
        "font_size": "medium",
        "simplified_ui": false,
        "hide_effects": false,
        "touch_target_size": 44
      },
      "performance": {
        "reduce_draw_calls": false,
        "texture_compression": true,
        "limit_animations": false,
        "disable_background_effects": false
      }
    },
    "high_end_mobile": {
      "name": "高端移动设备",
      "description": "适用于旗舰级智能手机和平板",
      "resolution": {
        "target_width": 1440,
        "target_height": 2560,
        "aspect_ratio": "16:9",
        "scale_mode": "contain"
      },
      "rendering": {
        "tile_size": 40,
        "anti_aliasing": true,
        "shadows": true,
        "shadow_quality": "medium",
        "particles": true,
        "particle_limit": 150,
        "post_processing": true,
        "post_processing_effects": ["bloom", "vignette"],
        "fog_quality": "high",
        "max_fps": 60
      },
      "ui": {
        "scale": 1.1,
        "font_size": "medium",
        "simplified_ui": false,
        "hide_effects": false,
        "touch_target_size": 44
      },
      "performance": {
        "reduce_draw_calls": false,
        "texture_compression": false,
        "limit_animations": false,
        "disable_background_effects": false
      }
    },
    "desktop_low": {
      "name": "低配置电脑",
