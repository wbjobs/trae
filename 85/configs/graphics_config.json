      "ui": {
        "scale": 1.15,
        "font_size": "large",
        "simplified_ui": false,
        "hide_effects": false,
        "touch_target_size": 50,
        "tablet_optimized_layout": true
      }
    },
    "tv": {
      "name": "智能电视",
      "description": "适用于智能电视和游戏主机",
      "resolution": {
        "target_width": 3840,
        "target_height": 2160,
        "aspect_ratio": "16:9",
        "scale_mode": "contain"
      },
      "rendering": {
        "tile_size": 48,
        "anti_aliasing": true,
        "shadows": true,
        "shadow_quality": "high",
        "particles": true,
        "particle_limit": 300,
        "post_processing": true,
        "fog_quality": "high",
        "max_fps": 60,
        "hdr_support": true
      },
      "ui": {
        "scale": 1.3,
        "font_size": "xlarge",
        "simplified_ui": false,
        "hide_effects": false,
        "touch_target_size": 64,
        "tv_optimized_layout": true,
        "safe_area_margin": 5
      }
    }
  },
  "adaptive_settings": {
    "enabled": true,
    "fps_target": 60,
    "quality_step_down_threshold": 45,
    "quality_step_up_threshold": 55,
    "min_quality": "low_end_mobile",
    "max_quality": "desktop_high",
    "stabilization_frames": 30
  },
  "aspect_ratios": {
    "16:9": { "width": 16, "height": 9, "safe": true },
    "16:10": { "width": 16, "height": 10, "safe": true },
    "4:3": { "width": 4, "height": 3, "safe": true },
    "21:9": { "width": 21, "height": 9, "safe": true, "ultrawide": true },
    "3:2": { "width": 3, "height": 2, "safe": true },
    "9:16": { "width": 9, "height": 16, "safe": true, "portrait": true },
    "10:16": { "width": 10, "height": 16, "safe": true, "portrait": true }
  },
  "font_sizes": {
