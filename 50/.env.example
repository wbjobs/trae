# Kafka配置
KAFKA_BROKERS=localhost:9093
INPUT_TOPIC=metrics-input
OUTPUT_TOPIC=anomaly-output

# 邮件告警配置
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=admin@example.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# 短信告警配置
ALERT_SMS_ENABLED=false
ALERT_SMS_API_URL=https://sms-api.example.com/send
ALERT_SMS_API_KEY=your-api-key
ALERT_SMS_PHONES=13800138000,13900139000

# 企业微信告警配置
ALERT_WECHAT_ENABLED=false
ALERT_WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# WebSocket配置
REACT_APP_WS_URL=ws://localhost:8083/ws/anomaly
