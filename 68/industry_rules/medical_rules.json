{
    "industry": "medical",
    "version": "1.0",
    "description": "医疗行业文档解析规则集",
    "extraction_rules": [
        {
            "name": "patient_name",
            "type": "keyword",
            "keywords": ["姓名", "患者姓名", "病人姓名"],
            "case_sensitive": false,
            "weight": 1.0,
            "description": "患者姓名提取",
            "category": "patient_info",
            "enabled": true
        },
        {
            "name": "patient_id",
            "type": "regex",
            "pattern": "病历号[：:]*\\s*[A-Za-z0-9]+",
            "case_sensitive": false,
            "weight": 1.0,
            "description": "病历号提取",
            "category": "patient_info",
            "enabled": true
        },
        {
            "name": "diagnosis",
            "type": "keyword",
            "keywords": ["诊断", "初步诊断", "最终诊断", "临床诊断"],
            "case_sensitive": false,
            "weight": 1.5,
            "description": "诊断信息提取",
            "category": "diagnosis",
            "enabled": true
        },
        {
            "name": "medication",
            "type": "keyword",
            "keywords": ["用药", "处方", "药品", "治疗方案"],
            "case_sensitive": false,
            "weight": 1.2,
            "description": "用药信息提取",
            "category": "treatment",
            "enabled": true
        }
    ],
    "correction_rules": [
        {
            "pattern": "CT片",
            "replacement": "CT影像"
        },
        {
            "pattern": "X光片",
            "replacement": "X线检查"
        }
    ],
    "domain_keywords": [
        "诊断", "治疗", "处方", "病历", "患者", "医院", "医生",
        "检查", "化验", "手术", "药品", "剂量", "用法", "疗程"
    ],
    "stop_words": [
        "的", "了", "和", "与", "或", "在", "是", "有", "为", "对"
    ],
    "metadata": {
        "created_at": "2024-01-01",
        "updated_at": "2024-01-01",
        "author": "medical_department"
    }
}
