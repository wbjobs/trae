SERVER_PORT=3001
SERVER_HOST=0.0.0.0

ETCD_ENDPOINTS=http://127.0.0.1:2379
ETCD_USERNAME=
ETCD_PASSWORD=
ETCD_RULES_KEY=/apisix/plugins/gray-routing/rules
ETCD_WATCH_KEY=/apisix/plugins/gray-routing

# Kafka 配置
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=gray-routing-requests
KAFKA_CLIENT_ID=gray-routing-backend
KAFKA_GROUP_ID=gray-routing-consumer

# 采样配置
SAMPLING_ENABLED=true
SAMPLING_RATE=0.01
MAX_BODY_SIZE=1048576

CORS_ORIGIN=*

LOG_LEVEL=info
