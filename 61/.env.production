NODE_ENV=production

# 服务端口
HTTP_PORT=3000
TCP_PORT=8888
WS_PORT=3001

# MySQL配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=iot_platform

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379

# InfluxDB配置
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_TOKEN=iot-token
INFLUXDB_ORG=iot-org
INFLUXDB_BUCKET=iot-data

# JWT配置
JWT_SECRET=iot-platform-secret-key-prod
JWT_EXPIRES_IN=12h

# 网关配置
GATEWAY_TIMEOUT=30000
HEARTBEAT_INTERVAL=15000
OFFLINE_THRESHOLD=45000
